{
  "manifest_version": 2,
  "name": "Semantic Search",
  "version": "2.7.0",
  "description": "Semantic (meaning-based) search over the full text of your Zotero PDFs, with a local MCP endpoint for LLMs.",
  "author": "Gherardo Carullo",
  "homepage_url": "https://github.com/ilDon/zotero-semantic-search",
  "icons": {
    "48": "content/icons/semantic-search.svg",
    "96": "content/icons/semantic-search.svg"
  },
  "applications": {
    "zotero": {
      "id": "semantic-search@ildon.github.io",
      "update_url": "https://github.com/ilDon/zotero-semantic-search/releases/latest/download/updates.json",
      "strict_min_version": "7.0",
      "strict_max_version": "10.*"
    }
  }
}
